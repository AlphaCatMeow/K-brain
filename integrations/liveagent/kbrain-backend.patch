+  const legacyKey = "liveagent.ui-settings.v1";
+  const local = new Map([
+    [legacyKey, JSON.stringify({
+      theme: "dark",
+      selectedModel: { customProviderId: "legacy-provider", model: "legacy-model" },
+      providers: [{
