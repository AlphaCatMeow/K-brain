-import { MEMORY_INDEX_HIDDEN_LINE_MARKER, MEMORY_PROMPT_TRUNCATION_SUFFIX } from "./injection";
-
-/** 单个增量块最多列出的条目数,超出时整轮转重冻结(见 planMemoryTurnInjection)。 */
-export const MEMORY_TURN_UPDATE_MAX_ENTRIES = 12;
