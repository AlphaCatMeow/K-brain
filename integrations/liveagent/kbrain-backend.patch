-    }
-  };
-
-  const endedByToolCallId = new Set<string>();
-
-  const checkDanglingToolCalls = (content: ReadonlyArray<{ type: string }>) => {
-    for (const block of content) {
-      if (block.type !== "toolCall") continue;
