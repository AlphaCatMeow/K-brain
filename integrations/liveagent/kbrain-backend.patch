-          }
-          case "toolcall_end": {
-            endedByToolCallId.add(event.toolCall.id);
-            checkEndedToolCall(event.contentIndex, event.toolCall);
-            break;
-          }
-          case "done": {
-            checkDanglingToolCalls(event.message.content);
-            break;
-          }
-          default:
-            break;
-        }
-        yield event;
-      }
-    },
