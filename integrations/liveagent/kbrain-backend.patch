+}
+
+for (const [name, baseUrl, expected] of [
+  ["default URL", undefined, "http://127.0.0.1:47321/share/public-token"],
+  ["configured backend URL", "http://kbrain.test:48123/proxy/", "http://kbrain.test:48123/proxy/share/public-token"],
