+		AgentId:   "offline-kbrain",
+		Payload: &gatewayv2.WebClientFrame_WorkspaceSubscribe{
+			WorkspaceSubscribe: &gatewayv2.WorkspaceSubscribeRequest{Workdir: workdir},
+		},
+	})
