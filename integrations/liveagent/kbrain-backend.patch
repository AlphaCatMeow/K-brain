-
-function isExplicitNoCacheOptions(value: unknown): boolean {
-  return (
-    Boolean(value) &&
-    typeof value === "object" &&
-    !Array.isArray(value) &&
-    (value as Record<string, unknown>).mode === "explicit"
-  );
-}
-
-/**
