+    return new Response(JSON.stringify(url.endsWith("/models") ? { models: [{ id: "discovered", contextWindow: 32000, maxOutputToken: 1000 }] } : { mode: "kbrain", defaultProvider: "", defaultModel: "", providers: [], models: [] }));
