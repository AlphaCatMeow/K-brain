-function riskLevelValue(value: unknown): RiskLevel | undefined {
-  const normalized = stringValue(value).toLowerCase();
-  if (normalized === "low" || normalized === "medium" || normalized === "high") {
-    return normalized;
-  }
-  return undefined;
-}
