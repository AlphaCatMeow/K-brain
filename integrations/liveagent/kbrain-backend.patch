+	close(backend.terminals[1])
+	if got := awaitQueueValue(t, controls); got.RequestId != "continue" || got.Type != "completed" {
+		t.Fatalf("continue completion = %#v", got)
+	}
+	awaitQueueIdle(t, relay)
+}
