+		onControl(start.RunID, &gatewayv2.ChatControlEvent{RequestId: start.RunID, ConversationId: start.ConversationID, Type: "queued_in_gui"})
+	}
+	close(ready)
+	if err != nil {
+		c.sm.FailChatCommand(agentID, runID, "kbrain_relay_error", err.Error())
+	}
