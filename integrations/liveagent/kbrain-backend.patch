+          ...(input.expected_revision ? { expected_revision: input.expected_revision } : {}),
+        }),
+      },
+    );
+    if (
+      result.version !== KBRAIN_PROTOCOL_VERSION ||
+      result.conversation_id !== conversationId ||
+      !result.run_id ||
+      !Number.isSafeInteger(result.accepted_seq)
+    ) {
