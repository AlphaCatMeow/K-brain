-function resolveWireValue(providerId, model, level) {
-  if (providerId === "claude_code") {
-    const runtime = resolveAnthropicThinkingRuntime(model, { reasoning: level });
-    return runtime.mode === "adaptive"
-      ? `effort:${runtime.effort}`
