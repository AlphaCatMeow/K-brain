-        .rev()
-        .find(|failure| {
-            !matches!(
-                failure.status,
-                Some(StatusCode::NOT_FOUND | StatusCode::METHOD_NOT_ALLOWED)
-            )
-        })
-        .or_else(|| failures.last())
-        .map(|failure| failure.message.clone())
-        .unwrap_or_else(|| "请求供应商模型列表失败".to_string())
-}
