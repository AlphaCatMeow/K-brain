-    if (!isRecord(message) || typeof message.content !== "string") {
-      return message;
-    }
-
-    changed = true;
-    return {
-      ...message,
-      content: [
-        {
-          type: "text",
-          text: message.content,
-        },
-      ],
-    };
-  });
-
-  return changed ? next : messages;
-}
