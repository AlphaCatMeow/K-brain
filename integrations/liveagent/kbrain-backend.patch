-export function isOfficialGeminiApiBaseUrl(baseUrl: string | undefined): boolean {
-  if (!baseUrl?.trim()) return false;
-  try {
-    return new URL(baseUrl).hostname === "generativelanguage.googleapis.com";
-  } catch {
-    return false;
-  }
-}
