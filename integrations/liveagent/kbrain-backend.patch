+        response.end(event(2, "assistant.message.created", { content: [{ type: "text", text: `round-${runCount}` }] }, { conversation_id: "backend-http", run_id: runId }) + event(3, "run.completed", {}, { conversation_id: "backend-http", run_id: runId }));
